    }
  },
  "hard_out_of_scope": [
    "runtime_theme_core_v2_implementation",
    "persistence_schema_migration_execution",
    "qml_bridge_implementation",
    "qml_settings_ui",
    "screen1_component_migration",
    "windows_dwm_implementation",
    "arrangement_or_live_work",
    "cloud_theme_sync",
    "arbitrary_qml_css_skin_scripting",
    "private_samples_dbs_indexes_caches_credentials_machine_paths"
  ]
}
