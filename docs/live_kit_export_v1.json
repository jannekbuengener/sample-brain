      ]
    },
    {
      "id": "path_metadata_reconciliation_1203",
      "refs": ["docs/PATH_METADATA_RECONCILIATION.md"]
    },
    {
      "id": "live_kit_edit_contract",
      "refs": ["docs/WORKBENCH_LIVE_KIT_EDIT_CONTRACT.md"]
    }
  ]
}
